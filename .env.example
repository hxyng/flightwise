# Local open model (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b

# Live flight status: AeroDataBox via API.market (free Basic tier). Empty -> mock data
AERODATABOX_KEY=
# Flight search: SerpApi google_flights (250 free searches/mo). Empty -> mock data
SERPAPI_KEY=
# Set to 1 to force mocks during the demo (Wi-Fi backup)
FLIGHTWISE_MOCK=0

# Snowflake (empty -> local DuckDB over data/flights.parquet)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=FLIGHTWISE
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=
FLIGHTS_TABLE=FLIGHTS

WATCH_INTERVAL_S=20
